# Kopie als android/keystore.properties anlegen und ausfuellen.
# Diese Datei NIEMALS ins Git einchecken (steht bereits in .gitignore).
#
# Keystore erzeugen (einmalig, Gueltigkeit ~27 Jahre):
#
#   keytool -genkeypair -v \
#     -keystore ff-sms-tool.jks \
#     -alias ffsms \
#     -keyalg RSA -keysize 4096 -validity 10000 \
#     -storetype JKS
#
# Die .jks-Datei sicher aufbewahren (z. B. Passwortmanager der Feuerwehr).
# Geht sie verloren, kann keine Update-APK mehr installiert werden, ohne die
# App vorher zu deinstallieren -> lokale Daten waeren weg.

storeFile=ff-sms-tool.jks
storePassword=CHANGE_ME
keyAlias=ffsms
keyPassword=CHANGE_ME
