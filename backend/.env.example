# Kopie als backend/.env anlegen und ausfuellen.
# Diese Datei niemals mit echten Werten einchecken.

# --- Datenbank -----------------------------------------------------------
DB_USER=ffsms
DB_PASSWORD=hier-ein-langes-zufaelliges-passwort
DB_NAME=ffsms

# --- Authentifizierung ---------------------------------------------------
# Format: kennung:schluessel[,weitere-kennung:schluessel]
# Der Schluessel bestimmt die Geraete-Kennung. Ein Geraet kann damit keine
# Daten unter fremder Kennung einliefern. Mindestens 16 Zeichen.
# Erzeugen z. B. mit:  openssl rand -hex 24
API_KEYS=ff-kuehwiesen-sms:HIER-EINEN-ECHTEN-SCHLUESSEL-EINTRAGEN

# --- ntfy ----------------------------------------------------------------
# Vollstaendige Topic-URL. Beim oeffentlichen ntfy.sh unbedingt einen langen,
# zufaelligen Topic-Namen waehlen: wer den Namen kennt, liest mit.
# Erzeugen z. B. mit:  echo "ff-sms-$(openssl rand -hex 8)"
NTFY_URL=https://ntfy.sh/ff-sms-BITTE-ZUFAELLIGEN-NAMEN-WAEHLEN
# Nur noetig bei einer ntfy-Instanz mit Zugriffsschutz.
NTFY_TOKEN=

# --- Schwellwerte fuer den Sofort-Alarm ----------------------------------
# Alarm, wenn eine einzelne Aussendung mehr Segmente verursacht:
ALERT_SEGMENTS_PER_CAMPAIGN=150
# Alarm, wenn die Monatssumme darueber liegt:
ALERT_SEGMENTS_PER_MONTH=1500

# --- Wochenreport --------------------------------------------------------
TZ_REPORT=Europe/Vienna
# Sonntag 20:00 Ortszeit. Die Zeitzone steckt in TZ_REPORT, nicht im Ausdruck.
WEEKLY_REPORT_CRON=0 20 * * 0
# Klartextname in der Betreffzeile, z. B. "FF Kuehwiesen".
REPORT_TITLE=FF-SMS

# --- Update-Kanal fuer die App ------------------------------------------
# Verzeichnis im Container. Es wird aus ./updates gemountet (siehe
# docker-compose.yml) und enthaelt:
#   app-release.apk  - das signierte Release-APK
#   release.json     - {"version_code": 2, "version_name": "1.0.1", "notes": "..."}
# Wird beides nicht hinterlegt, meldet der Endpunkt schlicht 404 und die App
# sagt "kein Update verfuegbar". Der SMS-Versand ist davon unabhaengig.
UPDATE_DIR=/data/updates
